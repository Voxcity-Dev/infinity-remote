# Infinity Remote - ambiente de build PRODUÇÃO.
# Lido em tempo de compilação por option_env! (libs/hbb_common/src/config.rs e src/common.rs).
# Uso: bash build-env/docker/build-linux.sh prod  |  workflow com ambiente=prod
# Repositório PÚBLICO: aqui só entra o que já é público (nome no DNS, URL da API, chave pública).
#
# Servidor hbbs/hbbr de produção pelo NOME, nunca pelo IP: o host é provisório (#34137);
# trocar de máquina = trocar o DNS e copiar a data/ do hbbs, sem recompilar o programa.
RENDEZVOUS_SERVER=remote.voxcity.com.br
# Chave PÚBLICA do hbbs de produção (não é segredo): data/id_ed25519.pub do hbbs de prod,
# nascida na 1ª subida em 26/11/2026 (onda 2 do plano de promoção, épico #34133).
# Trocar esta chave = recompilar e reinstalar todo programa já instalado.
RS_PUB_KEY=NkzmpsG7m3qnyTlPtWRMgTovJ1eERkvg8tK4Q44PvGM=
# API do Infinity em produção (rotas /remote/api/* do core pelo gateway; contrato-api-cliente.md).
API_SERVER=https://api-gateway.voxcity.com.br/core/remote
