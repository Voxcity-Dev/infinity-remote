# Infinity Remote - imagem de build Linux (Flutter) reprodutível.
# Versões espelham .github/workflows/flutter-build.yml e bridge.yml da tag 1.4.9.
# O workflow usa ubuntu18.04 para o binário (glibc antiga); aqui ubuntu:22.04
# => o .deb gerado exige glibc >= 2.35 (Ubuntu 22.04+/Debian 12+).
#
# Build da imagem:
#   docker build -t infinity-remote-build:linux -f build-env/docker/Dockerfile.linux .github/patches
#   (contexto = .github/patches, só para o patch do Flutter)
# Uso: ver build-env/docker/build-linux.sh
FROM ubuntu:22.04

ARG RUST_VERSION=1.75
ARG FLUTTER_VERSION=3.24.5
ARG VCPKG_COMMIT_ID=120deac3062162151622ca4860575a33844ba10b
ARG FLUTTER_RUST_BRIDGE_VERSION=1.80.1
ARG CARGO_EXPAND_VERSION=1.0.95

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

# Pacotes do job build-rustdesk-linux (install:) + bridge.yml + vcpkg (autotools) + prova (xvfb).
RUN apt-get update -y && apt-get install -y --no-install-recommends \
      build-essential clang cmake curl gcc git g++ ca-certificates \
      libayatana-appindicator3-dev libasound2-dev libclang-dev llvm-dev \
      libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev libgtk-3-dev \
      libpam0g-dev libpulse-dev libva-dev libdrm-dev libxcb-randr0-dev \
      libxcb-shape0-dev libxcb-xfixes0-dev libxdo-dev libxfixes-dev \
      nasm ninja-build pkg-config tree python3 rpm unzip zip wget xz-utils \
      libssl-dev liblzma-dev libstdc++-12-dev \
      autoconf automake libtool bison flex gperf \
      dpkg-dev file xvfb xauth dbus-x11 \
    && apt-get remove -y libopus-dev || true \
    && rm -rf /var/lib/apt/lists/*

# Rust (toolchain do workflow) - RUSTUP_HOME/CARGO_HOME fixos em /opt; o registry
# vai para o volume de cache em tempo de execução (CARGO_HOME=/cache/cargo).
ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:/opt/flutter/bin:$PATH
RUN export CARGO_BUILD_JOBS=3 \
    && curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
      --default-toolchain ${RUST_VERSION} --component rustfmt \
    && cargo install cargo-expand --version ${CARGO_EXPAND_VERSION} --locked \
    && cargo install flutter_rust_bridge_codegen --version ${FLUTTER_RUST_BRIDGE_VERSION} --features uuid --locked \
    && rm -rf /opt/cargo/registry /opt/cargo/git \
    && chmod -R a+rwX /opt/rustup /opt/cargo

# Flutter (tarball oficial, como o workflow) + patch do dropdown_menu da 3.24.x.
COPY flutter_3.24.4_dropdown_menu_enableFilter.diff /tmp/
RUN cd /opt \
    && wget -q https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_${FLUTTER_VERSION}-stable.tar.xz \
    && tar xf flutter_linux_${FLUTTER_VERSION}-stable.tar.xz && rm flutter_linux_${FLUTTER_VERSION}-stable.tar.xz \
    && git config --system --add safe.directory '*' \
    && cd /opt/flutter && git apply /tmp/flutter_3.24.4_dropdown_menu_enableFilter.diff \
    && flutter config --no-analytics && flutter config --enable-linux-desktop \
    && flutter precache --linux --no-android --no-ios --no-web --no-macos --no-windows --no-fuchsia \
    && chmod -R a+rwX /opt/flutter

# vcpkg no commit do workflow (clone completo: o manifest usa baseline por git).
RUN git clone https://github.com/microsoft/vcpkg /opt/vcpkg \
    && cd /opt/vcpkg && git checkout ${VCPKG_COMMIT_ID} \
    && ./bootstrap-vcpkg.sh -disableMetrics \
    && chmod -R a+rwX /opt/vcpkg

ENV VCPKG_ROOT=/opt/vcpkg \
    VCPKG_DISABLE_METRICS=1 \
    VCPKG_DEFAULT_BINARY_CACHE=/cache/vcpkg-bincache \
    VCPKG_DOWNLOADS=/cache/vcpkg-downloads \
    PUB_CACHE=/cache/pub-cache \
    HOME=/cache/home

WORKDIR /workspace
